# Copy to .env for local testing (`node --env-file=.env scripts/send-bonus-pool-update.mjs`).
# In production these are set as GitHub Actions repository secrets, not committed here.

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxxxx/xxxxxxx/

# Optional overrides
# BONUS_POOL_RANGE=BonusPool!A2:B
# CREW_RANGE=Crew!A2:C
# CURRENCY=USD
# MESSAGE_TEMPLATE=Hey {{name}}! The {{month}} bonus pool is {{amount}}. Nice work crew!
